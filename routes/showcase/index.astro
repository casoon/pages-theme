---
import config from 'virtual:casoon-pages/config';
import { examples } from 'virtual:casoon-pages/showcase';
import ExamplePanel from '../../components/ExamplePanel.astro';
import ShowcaseExplorer from '../../components/ShowcaseExplorer.astro';
import Base from '../../layouts/Base.astro';
import { t } from '../../lib/i18n';
import { descriptionHtml, groupExamples, type ShowcaseExample } from '../../lib/showcase';
import { url } from '../../lib/url';

const s = t(config.lang);

const groups = groupExamples(examples as ShowcaseExample[]);
const grouped = groups.some((g) => g.label !== '');
---

<Base title={s.showcase} description={s.showcaseDescription(config.name)}>
  {
    config.showcaseLayout === 'explorer' ? (
      <div class="explorer-page">
        <nav class="crumb" aria-label={s.breadcrumb}>
          <ol>
            <li>
              <a href={url()}>{config.name}</a>
            </li>
            <li aria-current="page">{s.showcase}</li>
          </ol>
        </nav>
        <div class="title-row">
          <h1>{s.showcase}</h1>
          <p class="lead">{config.showcaseLead || s.showcaseLead(config.name)}</p>
        </div>
        <ShowcaseExplorer examples={examples as ShowcaseExample[]} />
      </div>
    ) : (
  <div class="page">
    <h1>{s.showcase}</h1>
    <p class="lead">{config.showcaseLead || s.showcaseLead(config.name)}</p>
    {
      grouped && (
        <nav class="jump" aria-label={s.showcase}>
          <ul>
            {groups.map((g) => (
              <li>
                <a href={`#${g.id}`}>
                  {g.label || s.showcase} <span class="count">{g.items.length}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    {
      groups.map((group) => (
        <section class="group" id={grouped ? group.id : undefined}>
          {grouped && group.label && <h2>{group.label}</h2>}
          <div class="list">
            {group.items
              .filter((example) => !example.preview)
              .map((example) => (
                <ExamplePanel example={example} />
              ))}
          </div>
          {group.items.some((example) => example.preview) && (
            <ul class="cards">
              {group.items
                .filter((example) => example.preview)
                .map((example) => (
                  <li class="card">
                    <a href={url(`showcase/${example.slug}/`)}>
                      <span class="preview" set:html={example.preview!.html} />
                      <span class="name">{example.title}</span>
                      {example.description && (
                        <span class="text cp-inline-code" set:html={descriptionHtml(example.description)} />
                      )}
                    </a>
                  </li>
                ))}
            </ul>
          )}
        </section>
      ))
    }
  </div>
    )
  }
</Base>

<style>
  .explorer-page {
    box-sizing: border-box;
    max-width: calc(var(--max-wide) + 80px);
    margin: 0 auto;
    padding: 72px 24px var(--section-y);
  }
  .explorer-page .crumb,
  .title-row {
    padding: 0 calc(var(--gutter) - 24px);
  }
  .crumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 14px;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 13px;
  }
  .crumb li + li::before {
    content: '/';
    margin-right: 8px;
  }
  .crumb a {
    color: var(--muted);
  }
  .crumb a:hover {
    color: var(--heading);
  }
  .crumb [aria-current] {
    color: var(--text);
  }
  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 20px 72px;
    margin-bottom: 48px;
  }
  .title-row h1 {
    flex: 1 1 380px;
    margin: 0;
    font-size: clamp(44px, 6vw, 84px);
    letter-spacing: -0.035em;
    line-height: 0.98;
  }
  .title-row .lead {
    flex: 1 1 380px;
    margin: 0;
    color: var(--heading);
    font-size: 20px;
    line-height: 1.5;
  }
  .page {
    max-width: var(--max);
    margin: 0 auto;
    padding: 56px 24px 96px;
  }
  h1 {
    margin: 0 0 12px;
    color: var(--heading);
    font-size: 38px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  h2 {
    margin: 0 0 16px;
    color: var(--heading);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .lead {
    max-width: 62ch;
    margin: 0 0 32px;
    font-size: 17.5px;
  }
  .jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 40px;
    padding: 0;
    list-style: none;
  }
  .jump a {
    display: inline-block;
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text);
    font-size: 14px;
    text-decoration: none;
  }
  .jump a:hover,
  .jump a:focus-visible {
    border-color: var(--accent);
    color: var(--heading);
  }
  .count {
    color: var(--muted);
  }
  .group + .group {
    margin-top: 56px;
  }
  .group {
    scroll-margin-top: 80px;
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .list:not(:empty) + .cards {
    margin-top: 20px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }
  .card a:hover,
  .card a:focus-visible {
    border-color: var(--accent);
  }
  .preview {
    display: block;
    line-height: 0;
  }
  .preview :global(img) {
    width: 100%;
    height: auto;
  }
  .name {
    color: var(--heading);
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
  }
  .text {
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.45;
  }
  .text :global(code) {
    font-size: 0.9em;
  }
</style>

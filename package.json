{
  "name": "@casoon/pages-theme",
  "version": "0.12.6",
  "description": "Shared Astro theme for the GitHub Pages sites of CASOON open-source projects",
  "type": "module",
  "license": "MIT",
  "author": "Jörn Seidel <joern.seidel@casoon.de> (https://www.casoon.de)",
  "homepage": "https://github.com/casoon/pages-theme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/casoon/pages-theme.git"
  },
  "bugs": {
    "url": "https://github.com/casoon/pages-theme/issues"
  },
  "exports": {
    ".": "./index.ts",
    "./content": "./content.ts",
    "./components": "./components/index.ts",
    "./components/*": "./components/*",
    "./ansi": "./lib/ansi.ts",
    "./url": "./lib/url.ts",
    "./showcase": "./lib/showcase.ts",
    "./layouts/*": "./layouts/*",
    "./lib/*": "./lib/*.ts",
    "./routes/*": "./routes/*",
    "./styles/*": "./styles/*"
  },
  "files": [
    "index.ts",
    "content.ts",
    "virtual.d.ts",
    "assets",
    "components",
    "fonts",
    "layouts",
    "lib",
    "routes",
    "styles"
  ],
  "keywords": [
    "astro-integration",
    "astro-theme",
    "withastro",
    "casoon"
  ],
  "peerDependencies": {
    "astro": "^7.3.2"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "sharp": "^0.35.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

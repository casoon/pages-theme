{
  "name": "@casoon/pages-theme",
  "version": "0.12.10",
  "description": "Shared Astro theme for the GitHub Pages sites of CASOON open-source projects",
  "type": "module",
  "license": "MIT",
  "author": "Jörn Seidel <joern.seidel@casoon.de> (https://www.casoon.de)",
  "homepage": "https://github.com/casoon/pages-theme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/casoon/pages-theme.git"
  },
  "bugs": {
    "url": "https://github.com/casoon/pages-theme/issues"
  },
  "exports": {
    ".": "./index.ts",
    "./content": "./content.ts",
    "./components": "./components/index.ts",
    "./components/*": "./components/*",
    "./ansi": "./lib/ansi.ts",
    "./url": "./lib/url.ts",
    "./showcase": "./lib/showcase.ts",
    "./layouts/*": "./layouts/*",
    "./lib/*": "./lib/*.ts",
    "./routes/*": "./routes/*",
    "./styles/*": "./styles/*"
  },
  "files": [
    "index.ts",
    "content.ts",
    "virtual.d.ts",
    "assets",
    "components",
    "fonts",
    "layouts",
    "lib",
    "routes",
    "styles"
  ],
  "keywords": [
    "astro-integration",
    "astro-theme",
    "withastro",
    "casoon"
  ],
  "scripts": {
    "dev": "pnpm --filter starter-site dev",
    "build": "pnpm --filter starter-site build",
    "preview": "pnpm --filter starter-site preview",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "type-check": "pnpm --filter starter-site type-check",
    "test:accent": "node scripts/test-accent.mjs"
  },
  "peerDependencies": {
    "astro": "^7.3.2"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "sharp": "^0.35.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1"
  },
  "packageManager": "pnpm@10.26.0"
}

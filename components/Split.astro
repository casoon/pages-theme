---
/**
 * A repeatable row: text beside a medium, open on the page background (no panel), with an
 * index. Lighter than `Spotlight`, which stays the one large sand panel. `reverse` puts the
 * medium on the left; the DOM order stays text first, so on a narrow screen the text leads.
 * `lead`, `note` and `points` take the changelog's inline Markdown subset. `numbered` sets the
 * points as 1/2/3 (they can match `marks` of a `CodeBlock` in the slot) instead of ticks.
 */
import { inlineMarkdown } from '../lib/changelog';

interface Props {
  title: string;
  lead: string;
  eyebrow?: string;
  index?: string;
  note?: string;
  points?: string[];
  numbered?: boolean;
  links?: { label: string; href: string }[];
  reverse?: boolean;
}

const {
  title,
  lead,
  eyebrow,
  index,
  note,
  points,
  numbered = false,
  links,
  reverse = false,
} = Astro.props;
const List = numbered ? 'ol' : 'ul';
---

<section class:list={['split', reverse && 'reverse']}>
  <div class="text">
    {
      (index || eyebrow) && (
        <p class="eyebrow">
          {index && <span class="index">{index}</span>}
          {eyebrow}
        </p>
      )
    }
    <h3>{title}</h3>
    <p class="lead" set:html={inlineMarkdown(lead)} />
    {note && <p class="note" set:html={inlineMarkdown(note)} />}
    {
      points && points.length > 0 && (
        <List class:list={['points', numbered && 'is-numbered']}>
          {points.map((point) => (
            <li>
              <span class="mark" aria-hidden="true">
                {numbered ? null : (
                  <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12.5l4.5 4.5L19 7.5" />
                  </svg>
                )}
              </span>
              <span set:html={inlineMarkdown(point)} />
            </li>
          ))}
        </List>
      )
    }
    {
      links && links.length > 0 && (
        <div class="links">
          {links.map((link) => (
            <a href={link.href}>{link.label} →</a>
          ))}
        </div>
      )
    }
  </div>
  <div class="media">
    <slot />
  </div>
</section>

<style>
  .split {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px 72px;
    max-width: var(--max-wide);
    margin: 0 auto;
    padding: 0 var(--gutter) var(--section-y);
  }
  .reverse {
    flex-direction: row-reverse;
  }
  .text {
    flex: 1 1 400px;
    min-width: 0;
  }
  .media {
    flex: 1.15 1 460px;
    min-width: 0;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 16px;
    color: var(--heading);
    font-size: 14px;
    text-transform: uppercase;
  }
  .index {
    color: var(--accent);
    font-family: var(--font-mono);
  }
  h3 {
    margin: 0 0 20px;
    color: var(--heading);
    font-size: var(--h-sub);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.12;
    text-wrap: balance;
  }
  .lead {
    margin: 0 0 20px;
    font-size: 18px;
    line-height: 1.65;
  }
  .note {
    margin: 0 0 28px;
    padding-left: 20px;
    border-left: 1px solid var(--border-strong);
    color: var(--heading);
    font-size: 16px;
    line-height: 1.6;
  }
  .lead :global(strong),
  .points :global(strong) {
    color: var(--heading);
    font-weight: 600;
  }
  .lead :global(code),
  .note :global(code),
  .points :global(code) {
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--code-bg);
    font-size: 0.9em;
  }
  .lead :global(a),
  .note :global(a),
  .points :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }
  .points {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
    font-size: 16px;
    line-height: 1.6;
  }
  .points.is-numbered {
    counter-reset: point;
  }
  .points li {
    display: flex;
    gap: 12px;
  }
  .mark {
    display: grid;
    flex: none;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-top: 2px;
    border-radius: 50%;
    background: var(--surface);
    color: var(--heading);
  }
  .is-numbered .mark {
    background: var(--ink);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 11px;
    counter-increment: point;
  }
  .is-numbered .mark::before {
    content: counter(point);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 26px;
  }
  .links a {
    color: var(--heading);
    font-size: 14.5px;
    font-weight: 600;
  }
  .links a:hover {
    color: var(--accent);
  }
  @media (max-width: 900px) {
    .split {
      padding-bottom: 88px;
    }
  }
</style>

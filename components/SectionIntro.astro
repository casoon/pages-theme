---
/**
 * Head of a section: the `h2` on the left, a short placing paragraph on the right, bottom
 * aligned. Wraps below each other on narrow screens. `lead` takes the changelog's inline
 * Markdown subset.
 */
import { inlineMarkdown } from '../lib/changelog';

interface Props {
  title: string;
  lead: string;
  eyebrow?: string;
}

const { title, lead, eyebrow } = Astro.props;
---

<section class="intro">
  <div class="title">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
  </div>
  <p class="lead" set:html={inlineMarkdown(lead)} />
</section>

<style>
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 24px 64px;
    max-width: var(--max);
    margin: 0 auto;
    padding: 112px 24px 72px;
  }
  .title {
    flex: 1 1 420px;
  }
  .eyebrow {
    margin: 0 0 16px;
    color: var(--heading);
    font-size: 14px;
    text-transform: uppercase;
  }
  h2 {
    margin: 0;
    color: var(--heading);
    font-size: clamp(34px, 4.4vw, 50px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-wrap: balance;
  }
  .lead {
    flex: 1 1 380px;
    margin: 0;
    font-size: 18px;
    line-height: 1.65;
  }
  .lead :global(strong) {
    color: var(--heading);
  }
  .lead :global(code) {
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--code-bg);
    font-size: 0.9em;
  }
</style>

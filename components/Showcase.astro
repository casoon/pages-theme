---
/**
 * A dark panel with a large picture or video — dark in both themes, like `Footer` and
 * `CallToAction`. Text left, medium (default slot) right; the medium may be an `<img>` or a
 * `<video>`. `lead` takes the changelog's inline Markdown subset.
 */
import { inlineMarkdown } from '../lib/changelog';

interface Props {
  title: string;
  lead: string;
  eyebrow?: string;
  link?: { label: string; href: string };
}

const { title, lead, eyebrow, link } = Astro.props;
---

<section class="showcase">
  <div class="text">
    {
      eyebrow && (
        <p class="eyebrow">
          <span class="dot" aria-hidden="true" />
          {eyebrow}
        </p>
      )
    }
    <h3>{title}</h3>
    <p class="lead" set:html={inlineMarkdown(lead)} />
    {link && <a class="button" href={link.href}>{link.label}</a>}
  </div>
  <div class="media">
    <slot />
  </div>
</section>

<style>
  .showcase {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px 56px;
    box-sizing: border-box;
    max-width: calc(var(--max) + 160px);
    margin: 0 auto 128px;
    padding: clamp(32px, 5.5vw, 80px);
    border-radius: clamp(32px, 4.2vw, var(--r-panel));
    background: #11100e;
    color: #cbc9c5;
  }
  @media (max-width: 1340px) {
    .showcase {
      margin-inline: 24px;
    }
  }
  .text {
    flex: 1 1 340px;
    min-width: 0;
  }
  .media {
    flex: 1.5 1 480px;
    min-width: 0;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 16px;
    color: #fff;
    font-size: 14px;
    text-transform: uppercase;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #f0815f;
  }
  h3 {
    margin: 0 0 20px;
    color: #fff;
    font-size: clamp(28px, 3.1vw, 40px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.12;
    text-wrap: balance;
  }
  .lead {
    margin: 0 0 28px;
    font-size: 18px;
    line-height: 1.65;
  }
  .lead :global(strong) {
    color: #fff;
  }
  .lead :global(code) {
    padding: 1px 5px;
    border-radius: 5px;
    background: rgb(255 255 255 / 0.1);
    font-size: 0.9em;
  }
  .lead :global(a) {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .button {
    display: inline-flex;
    align-items: center;
    min-height: 47px;
    padding: 0 25px;
    border-radius: 30px;
    background: #fff;
    color: #11100e;
    font-size: 15px;
    font-weight: 500;
  }
  .button:hover {
    background: #f4f1eb;
  }
  .media :global(img),
  .media :global(video) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 16px;
  }
</style>

---
/**
 * Static badge: version, licence, registry, status. No external badge services.
 * `muted`, `accent`, `brand` colour the text. For a result class (e.g. Automatic / Hint only /
 * Manual) three levels of emphasis that do not rely on colour alone: `solid` (filled), `soft`
 * (tinted) and `muted` (outline only).
 */
interface Props {
  tone?: 'muted' | 'accent' | 'brand' | 'solid' | 'soft';
}

const { tone = 'muted' } = Astro.props;
---

<span class:list={['badge', tone]}><slot /></span>

<style>
  .badge {
    display: inline-block;
    padding: 3px 9px;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
  }
  .muted {
    color: var(--muted);
  }
  .accent {
    color: var(--accent);
  }
  .brand {
    color: var(--brand);
  }
  .solid {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--bg);
  }
  .soft {
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
    background: var(--accent-soft);
    color: var(--accent);
  }
</style>

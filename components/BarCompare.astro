---
/**
 * Measurements as pairs of bars, two series per measurement. The bar is `value` over the
 * largest value of the component (at least 4 px wide); the number shown is `display`, so the
 * theme formats nothing. Every value is text beside its bar, and the two series differ in
 * lightness, not only in hue. `facts` sit in a grid of 2, 3, 4 or 6 tiles; any other count (5, 7 …)
 * would leave a field empty, so it is set as rows, label left and value right. The default slot is the footnote (device, date, method link).
 */
interface Props {
  title: string;
  series: [string, string];
  rows: { label: string; values: [number, number]; display: [string, string] }[];
  facts?: { label: string; value: string }[];
}

const { title, series, rows, facts } = Astro.props;
const max = Math.max(...rows.flatMap((row) => row.values), Number.MIN_VALUE);
const pct = (v: number) => `${((v / max) * 100).toFixed(2)}%`;
const hasNote = Astro.slots.has('default');
const factsAsList = facts !== undefined && ![1, 2, 3, 4, 6].includes(facts.length);
---

<figure class="barcompare">
  <figcaption>
    <span class="title">{title}</span>
    <span class="legend">
      <span><i class="swatch s0" aria-hidden="true"></i>{series[0]}</span>
      <span><i class="swatch s1" aria-hidden="true"></i>{series[1]}</span>
    </span>
  </figcaption>
  <div class="rows">
    {
      rows.map((row) => (
        <div class="row">
          <span class="label">{row.label}</span>
          {row.values.map((value, i) => (
            <div class="line">
              <div class="track">
                <div class={`bar s${i}`} style={`width: ${pct(value)}`} />
              </div>
              <span class="num">
                <span class="visually-hidden">{series[i]}: </span>
                {row.display[i]}
              </span>
            </div>
          ))}
        </div>
      ))
    }
  </div>
  {
    facts && facts.length > 0 && (
      <dl class:list={['facts', factsAsList ? 'is-list' : `n-${facts.length}`]}>
        {facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    )
  }
  {
    hasNote && (
      <p class="note">
        <slot />
      </p>
    )
  }
</figure>

<style>
  .barcompare {
    box-sizing: border-box;
    min-width: 0;
    margin: 0;
    padding: clamp(20px, 3vw, 32px);
    border-radius: var(--r-card);
    background: var(--surface);
    box-shadow: 2px 2px 0 var(--shadow-hard);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 20px;
    margin-bottom: 28px;
  }
  .title {
    color: var(--heading);
    font-size: 17px;
    font-weight: 600;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .legend span {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .swatch {
    width: 10px;
    height: 10px;
    border-radius: 3px;
  }
  .s0 {
    background: var(--ink);
  }
  .s1 {
    background: var(--accent-top);
  }
  .rows {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .row {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .label {
    color: var(--heading);
    font-size: 15px;
    font-weight: 500;
  }
  .line {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .track {
    flex: 1;
    height: 14px;
    border-radius: 4px;
    background: var(--bg);
  }
  .bar {
    min-width: 4px;
    height: 100%;
    border-radius: 4px;
  }
  .num {
    flex: none;
    width: 72px;
    color: var(--heading);
    font-family: var(--font-mono);
    font-size: 13px;
    text-align: right;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(150px, 100%), 1fr));
    gap: 16px 24px;
    margin: 28px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .facts.n-2,
  .facts.n-4 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .facts.n-3,
  .facts.n-6 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  @media (max-width: 480px) {
    .facts.n-3 {
      grid-template-columns: minmax(0, 1fr);
    }
    .facts.n-6 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Rows: label left, value right. */
  .facts.is-list {
    display: block;
  }
  .is-list > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding: 10px 0;
    border-top: 1px solid var(--border);
  }
  .is-list > div:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .is-list dd {
    margin: 0;
    font-size: 17px;
    text-align: right;
  }
  dt {
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.45;
  }
  dd {
    margin: 2px 0 0;
    color: var(--heading);
    font-size: 20px;
    font-weight: 600;
  }
  .note {
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }
  .note :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>

---
/**
 * An editorial list: the heading left, rows of term + text right (a `<dl>`). The quieter
 * alternative to a second `Features` grid. `body` is plain text.
 */
interface Props {
  heading: string;
  items: { title: string; body: string }[];
  /** Heading level: `section` (default) or the smaller `sub`. */
  size?: 'section' | 'sub';
}

const { heading, items, size = 'section' } = Astro.props;
---

<section style={size === 'sub' ? '--h-size: var(--h-sub)' : undefined} class="audience">
  <h2>{heading}</h2>
  <dl>
    {
      items.map((item) => (
        <div>
          <dt>{item.title}</dt>
          <dd>{item.body}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .audience {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 32px 72px;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px var(--section-y);
  }
  h2 {
    flex: 1 1 260px;
    margin: 0;
    color: var(--heading);
    font-size: var(--h-size, var(--h-section));
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  dl {
    display: flex;
    flex: 2.4 1 520px;
    flex-direction: column;
    min-width: 0;
    margin: 0;
  }
  div {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 40px;
    padding: 28px 0;
    border-top: 1px solid var(--border-strong);
  }
  div:first-child {
    border-top-color: var(--heading);
  }
  div:last-child {
    border-bottom: 1px solid var(--border-strong);
  }
  dt {
    flex: 1 1 220px;
    color: var(--heading);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.3;
  }
  dd {
    flex: 1.5 1 300px;
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
  }
</style>

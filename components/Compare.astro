---
/**
 * A comparison table, the last column raised. A real `<table>`: column headers in the head,
 * the topic of each row as a row header, in a box that scrolls sideways under 760 px. The first
 * header cell (the topic column) is visually hidden and reads "Topic" (`topicLabel`).
 */
import { inlineMarkdown } from '../lib/changelog';

interface Props {
  columns: [string, string];
  rows: { topic: string; other: string; own: string }[];
  title?: string;
  lead?: string;
  link?: { label: string; href: string };
  topicLabel?: string;
}

const { columns, rows, title, lead, link, topicLabel = 'Topic' } = Astro.props;
---

<section class="compare">
  {title && <h2>{title}</h2>}
  {lead && <p class="lead" set:html={inlineMarkdown(lead)} />}
  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th scope="col" class="topic-col"><span class="visually-hidden">{topicLabel}</span></th>
          <th scope="col" class="other-col">{columns[0]}</th>
          <th scope="col" class="own-col">{columns[1]}</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              <th scope="row">{row.topic}</th>
              <td>{row.other}</td>
              <td class="own">{row.own}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  {link && <p class="more"><a href={link.href}>{link.label} →</a></p>}
</section>

<style>
  .compare {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 128px;
  }
  h2 {
    max-width: 20ch;
    margin: 0 0 16px;
    color: var(--heading);
    font-size: clamp(34px, 4.4vw, 50px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-wrap: balance;
  }
  .lead {
    max-width: 60ch;
    margin: 0 0 40px;
    font-size: 18px;
    line-height: 1.65;
  }
  .scroll {
    overflow-x: auto;
  }
  table {
    width: 100%;
    min-width: 760px;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 15px;
    line-height: 1.5;
    text-align: left;
  }
  th,
  td {
    vertical-align: top;
  }
  thead th {
    border-bottom: 1px solid var(--border-strong);
  }
  .topic-col {
    width: 22%;
    padding: 16px 20px 16px 0;
  }
  .other-col {
    width: 36%;
    padding: 16px 20px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
  }
  .own-col {
    width: 42%;
    padding: 18px 24px;
    border-radius: var(--r-card) var(--r-card) 0 0;
    background: var(--ink);
    color: var(--bg);
    font-size: 16px;
    font-weight: 600;
  }
  tbody th {
    padding: 18px 20px 18px 0;
    border-bottom: 1px solid var(--border);
    color: var(--heading);
    font-weight: 600;
  }
  td {
    padding: 18px 20px;
    border-bottom: 1px solid var(--border);
  }
  td.own {
    padding-inline: 24px;
    background: var(--surface);
    color: var(--heading);
  }
  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }
  tbody tr:last-child td.own {
    padding-bottom: 22px;
    border-radius: 0 0 var(--r-card) var(--r-card);
    box-shadow: 0 2px 0 var(--shadow-hard);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .more {
    margin: 28px 0 0;
  }
  .more a {
    color: var(--heading);
    font-size: 14.5px;
    font-weight: 600;
  }
  .more a:hover {
    color: var(--accent);
  }
</style>

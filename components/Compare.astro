---
/**
 * A comparison table with two to four columns, one of them raised. A real `<table>`: column
 * headers in the head, the topic of each row as a row header. The first header cell (the topic
 * column) is visually hidden and reads "Topic" (`topicLabel`).
 *
 * Two forms of the data. Two columns as before: `columns: [string, string]` and rows of
 * `{ topic, other, own }`, the last column raised. New: `columns` as a list of `{ title,
 * label?, badge? }` (or plain strings) and rows of `{ topic, cells }`; `highlight` is the index
 * of the raised column (none when left out). A row with a single cell spans all columns.
 * Cells, `lead` take the changelog's inline Markdown subset, so a measurement can be bold.
 *
 * Under 700 px the table is replaced by a list: per topic an `h3`, beneath it the cells, each
 * with its column title, the raised one on a white surface. Nothing scrolls sideways.
 */
import { inlineMarkdown } from '../lib/changelog';

type Column = string | { title: string; label?: string; badge?: string };
type Row = { topic: string; other?: string; own?: string; cells?: string[] };

interface Props {
  columns: Column[];
  rows: Row[];
  /** Index of the raised column. Left out: the last of two columns in the `other`/`own` form, else none. */
  highlight?: number;
  title?: string;
  lead?: string;
  link?: { label: string; href: string };
  topicLabel?: string;
  /** Heading level: `section` (default) or the smaller `sub`. */
  size?: 'section' | 'sub';
}

const { columns, rows, title, lead, link, topicLabel = 'Topic', size = 'section' } = Astro.props;

const cols = columns.map((c) => (typeof c === 'string' ? { title: c } : c)) as {
  title: string;
  label?: string;
  badge?: string;
}[];
const legacy = rows.every((row) => !row.cells);
const highlight = Astro.props.highlight ?? (legacy && cols.length === 2 ? 1 : undefined);
const spans = (cells: string[]) => cells.length === 1 && cols.length > 1;
const cellRows = rows.map((row) => ({
  topic: row.topic,
  cells: (row.cells ?? [row.other ?? '', row.own ?? '']).map((c) => inlineMarkdown(c)),
}));
// The raised column ends (rounded, with its shadow) at the last row of a run, so a row that
// spans all columns breaks it cleanly.
const body = cellRows.map((row, i) => ({
  ...row,
  end: !spans(row.cells) && (i === cellRows.length - 1 || spans(cellRows[i + 1].cells)),
}));
---

<section style={size === 'sub' ? '--h-size: var(--h-sub)' : undefined} class="compare">
  {title && <h2>{title}</h2>}
  {lead && <p class="lead" set:html={inlineMarkdown(lead)} />}
  <div class="scroll">
    <table style={`--cols: ${cols.length}`}>
      <thead>
        <tr>
          <th scope="col" class="topic-col"><span class="visually-hidden">{topicLabel}</span></th>
          {
            cols.map((col, i) => (
              <th scope="col" class:list={['col', i === highlight && 'hl']}>
                {col.label && <span class="label">{col.label}</span>}
                <span class="title">{col.title}</span>
                {col.badge && <span class="badge">{col.badge}</span>}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          body.map((row) => (
            <tr>
              <th scope="row">{row.topic}</th>
              {spans(row.cells) ? (
                <td colspan={cols.length} class="span" set:html={row.cells[0]} />
              ) : (
                row.cells.map((cell, i) => (
                  <td class:list={[i === highlight && 'hl', i === highlight && row.end && 'end']} set:html={cell} />
                ))
              )}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <div class="stacked">
    {
      body.map((row) => (
        <div class="item">
          <h3>{row.topic}</h3>
          {spans(row.cells) ? (
            <p class="cell" set:html={row.cells[0]} />
          ) : (
            row.cells.map((cell, i) => (
              <p class:list={['cell', i === highlight && 'hl']}>
                <span class="cn">{cols[i]?.title}</span>
                <span set:html={cell} />
              </p>
            ))
          )}
        </div>
      ))
    }
  </div>
  {link && <p class="more"><a href={link.href}>{link.label} →</a></p>}
</section>

<style>
  .compare {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px var(--section-y);
  }
  h2 {
    max-width: 20ch;
    margin: 0 0 16px;
    color: var(--heading);
    font-size: var(--h-size, var(--h-section));
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-wrap: balance;
  }
  .lead {
    max-width: 60ch;
    margin: 0 0 40px;
    font-size: 18px;
    line-height: 1.65;
  }
  .lead :global(strong),
  td :global(strong),
  .cell :global(strong) {
    color: var(--heading);
    font-weight: 600;
  }
  td :global(code),
  .cell :global(code) {
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--code-bg);
    font-size: 0.9em;
  }
  td :global(a),
  .cell :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }
  .scroll {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 15px;
    line-height: 1.5;
    text-align: left;
  }
  th,
  td {
    vertical-align: top;
  }
  thead th {
    border-bottom: 1px solid var(--border-strong);
  }
  .topic-col {
    width: 22%;
    padding: 16px 20px 16px 0;
  }
  .col {
    padding: 16px 20px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
  }
  .col .label {
    display: block;
    margin-bottom: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
  }
  .col .badge {
    display: inline-block;
    margin-left: 8px;
    padding: 2px 8px;
    border: 1px solid currentcolor;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .col.hl {
    padding: 18px 24px;
    border-radius: var(--r-card) var(--r-card) 0 0;
    background: var(--ink);
    color: var(--bg);
    font-size: 16px;
    font-weight: 600;
  }
  tbody th {
    padding: 18px 20px 18px 0;
    border-bottom: 1px solid var(--border);
    color: var(--heading);
    font-weight: 600;
  }
  td {
    padding: 18px 20px;
    border-bottom: 1px solid var(--border);
  }
  td.hl {
    padding-inline: 24px;
    background: var(--surface);
    color: var(--heading);
  }
  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }
  td.hl.end {
    padding-bottom: 22px;
    border-bottom: 0;
    border-radius: 0 0 var(--r-card) var(--r-card);
    box-shadow: 0 2px 0 var(--shadow-hard);
  }
  td.span {
    color: var(--heading);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .stacked {
    display: none;
  }
  .more {
    margin: 28px 0 0;
  }
  .more a {
    color: var(--heading);
    font-size: 14.5px;
    font-weight: 600;
  }
  .more a:hover {
    color: var(--accent);
  }

  /* Phones: one block per topic instead of a table. */
  @media (max-width: 700px) {
    .scroll {
      display: none;
    }
    .stacked {
      display: block;
    }
    .item {
      padding: 22px 0;
      border-top: 1px solid var(--border);
    }
    .item:last-child {
      border-bottom: 1px solid var(--border);
    }
    h3 {
      margin: 0 0 12px;
      color: var(--heading);
      font-size: 17px;
      font-weight: 600;
    }
    .cell {
      margin: 0;
      padding: 10px 0;
      font-size: 15px;
      line-height: 1.55;
    }
    .cell.hl {
      padding: 12px 16px;
      border-radius: 12px;
      background: var(--surface);
      box-shadow: 0 2px 0 var(--shadow-hard);
      color: var(--heading);
    }
    .cn {
      display: block;
      margin-bottom: 2px;
      color: var(--muted);
      font-size: 12.5px;
      font-weight: 500;
    }
  }
</style>

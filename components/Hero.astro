---
/**
 * Start-page hero in three layouts:
 *   split     — text beside the `output` slot (default)
 *   stack     — centred text, then a band: `source` slot → `command` → `output` slot
 *   editorial — full-width title, lead beside the default slot, `output` slot below
 * `tone="invert"` puts any of them on a dark brand ground.
 */
import config from 'virtual:casoon-pages/config';
import { t } from '../lib/i18n';

interface Props {
  title: string;
  lead: string;
  eyebrow?: string;
  layout?: 'split' | 'stack' | 'editorial';
  /** Shown between the `source` and `output` slots of the stack layout, e.g. `astro build`. */
  command?: string;
  tone?: 'plain' | 'invert';
}

const {
  title,
  lead,
  eyebrow = t(config.lang).heroEyebrow,
  layout = 'split',
  command,
  tone = 'plain',
} = Astro.props;
const hasSource = Astro.slots.has('source');
// An eyebrow that starts with "CASOON" marks the project as one of the family: it is set as a
// badge with the logo mark, and the rest ("Open Source", "Proof of Concept") follows it.
const family = eyebrow.match(/^CASOON\b\s*(?:·\s*)?(.*)$/);
---

<section class:list={['hero', `is-${layout}`, tone === 'invert' && 'invert']}>
  {
    layout === 'split' && (
      <div class="inner">
        <div>
          <p class:list={['eyebrow', family && 'family']}>
            {family ? (
              <>
                <span class="mark" aria-hidden="true">
                  <svg viewBox="110 92 280 316">
                    <path d="M169.49,108.38c-13.22,7.76-23.78,18.14-31.69,31.15-7.9,13.01-11.85,27.49-11.85,43.44v135.58c0,15.52,3.95,29.71,11.85,42.57,7.9,12.86,18.47,23.1,31.69,30.72,13.22,7.62,27.88,11.42,43.97,11.42h160.59v-45.48h-160.59c-11.64,0-21.55-3.91-29.75-11.74-8.19-7.83-12.28-17.21-12.28-28.13v-134.93c0-11.35,4.09-21.01,12.28-28.99,8.19-7.98,18.11-11.96,29.75-11.96h160.59v-45.26h-160.59c-16.09,0-30.75,3.88-43.97,11.64Z" />
                  </svg>
                </span>
                <span class="name">CASOON</span>
                {family[1] && <span class="rest">{family[1]}</span>}
              </>
            ) : (
              eyebrow
            )}
          </p>
          <h1>{title}</h1>
          <p class="lead">{lead}</p>
          <slot />
        </div>
        <div class="output glow">
          <div class="glow-inner">
            <slot name="output" />
          </div>
        </div>
      </div>
    )
  }

  {
    layout === 'stack' && (
      <div class="inner">
        <div class="head">
          <p class:list={['eyebrow', family && 'family']}>
            {family ? (
              <>
                <span class="mark" aria-hidden="true">
                  <svg viewBox="110 92 280 316">
                    <path d="M169.49,108.38c-13.22,7.76-23.78,18.14-31.69,31.15-7.9,13.01-11.85,27.49-11.85,43.44v135.58c0,15.52,3.95,29.71,11.85,42.57,7.9,12.86,18.47,23.1,31.69,30.72,13.22,7.62,27.88,11.42,43.97,11.42h160.59v-45.48h-160.59c-11.64,0-21.55-3.91-29.75-11.74-8.19-7.83-12.28-17.21-12.28-28.13v-134.93c0-11.35,4.09-21.01,12.28-28.99,8.19-7.98,18.11-11.96,29.75-11.96h160.59v-45.26h-160.59c-16.09,0-30.75,3.88-43.97,11.64Z" />
                  </svg>
                </span>
                <span class="name">CASOON</span>
                {family[1] && <span class="rest">{family[1]}</span>}
              </>
            ) : (
              eyebrow
            )}
          </p>
          <h1>{title}</h1>
          <p class="lead">{lead}</p>
        </div>
        <div class="band">
          {hasSource && (
            <div class="source">
              <slot name="source" />
            </div>
          )}
          {hasSource && command && (
            <p class="step">
              <span class="pill">{command}</span>
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </p>
          )}
          <div class="output">
            <slot name="output" />
          </div>
        </div>
        <div class="actions">
          <slot />
        </div>
      </div>
    )
  }

  {
    layout === 'editorial' && (
      <div class="inner">
        <p class:list={['eyebrow', family && 'family']}>
          {family ? (
            <>
              <span class="mark" aria-hidden="true">
                <svg viewBox="110 92 280 316">
                  <path d="M169.49,108.38c-13.22,7.76-23.78,18.14-31.69,31.15-7.9,13.01-11.85,27.49-11.85,43.44v135.58c0,15.52,3.95,29.71,11.85,42.57,7.9,12.86,18.47,23.1,31.69,30.72,13.22,7.62,27.88,11.42,43.97,11.42h160.59v-45.48h-160.59c-11.64,0-21.55-3.91-29.75-11.74-8.19-7.83-12.28-17.21-12.28-28.13v-134.93c0-11.35,4.09-21.01,12.28-28.99,8.19-7.98,18.11-11.96,29.75-11.96h160.59v-45.26h-160.59c-16.09,0-30.75,3.88-43.97,11.64Z" />
                </svg>
              </span>
              <span class="name">CASOON</span>
              {family[1] && <span class="rest">{family[1]}</span>}
            </>
          ) : (
            eyebrow
          )}
        </p>
        <h1>{title}</h1>
        <div class="row">
          <p class="lead">{lead}</p>
          <div class="actions">
            <slot />
          </div>
        </div>
        <div class="output">
          <slot name="output" />
        </div>
      </div>
    )
  }
</section>

<style>
  /* Sand ground. */
  .hero {
    position: relative;
    margin-top: calc(-1 * (var(--header-h) + 14px));
    padding-top: calc(var(--header-h) + 14px);
    background: var(--bg-deep);
    overflow: hidden;
  }
  .inner {
    position: relative;
    max-width: 1240px;
    margin: 0 auto;
    padding: 88px 40px 140px;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    color: var(--heading);
    font-size: 15px;
    line-height: 1.6;
    text-transform: uppercase;
  }
  .eyebrow::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-fill);
  }
  /* Family badge: logo mark, the name in wide caps, then the rest after a hairline. A slow
     sheen crosses it now and then. */
  .eyebrow.family {
    position: relative;
    display: inline-flex;
    gap: 0;
    padding: 3px 12px 3px 3px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 60%, transparent);
    font-size: 11px;
    letter-spacing: 0.06em;
    line-height: 1;
  }
  .eyebrow.family::before {
    content: none;
  }
  .eyebrow.family::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / 0.3) 50%, transparent 65%);
    translate: -100% 0;
    animation: family-sheen 7s ease-in-out 1.5s infinite;
    pointer-events: none;
  }
  @keyframes family-sheen {
    0% {
      translate: -100% 0;
    }
    25%,
    100% {
      translate: 100% 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .eyebrow.family::after {
      content: none;
    }
  }
  .mark {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #028baa;
  }
  .mark svg {
    width: 9px;
    height: 9px;
    fill: #fff;
  }
  .name {
    margin-left: 8px;
    font-weight: 600;
    letter-spacing: 0.14em;
  }
  .rest {
    margin-left: 9px;
    padding-left: 9px;
    border-left: 1px solid var(--border);
    color: var(--muted);
    font-weight: 500;
  }
  h1 {
    margin: 0 0 28px;
    color: var(--heading);
    font-size: clamp(44px, 6vw, 84px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }
  .lead {
    max-width: 31rem;
    margin: 0 0 34px;
    color: var(--heading);
    font-size: 20px;
    line-height: 1.6;
  }
  /* Output in a card whose edge carries a slowly turning orange arc. */
  .glow {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 30px;
    background: #f0ebe2;
    box-shadow: var(--shadow-lift);
  }
  .glow::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 50%;
    left: 50%;
    width: 220%;
    aspect-ratio: 1;
    translate: -50% -50%;
    background: conic-gradient(rgb(236 74 32 / 0) 0deg 185deg, #ec4a20 360deg);
    animation: glow-spin 8.15s linear infinite;
  }
  .glow-inner {
    margin: 4px;
    overflow: hidden;
    border-radius: 27px;
    background: var(--surface);
  }
  .glow-inner :global(.terminal),
  .glow-inner :global(figure) {
    border: 0;
    border-radius: 0;
  }
  @keyframes glow-spin {
    to {
      rotate: 360deg;
    }
  }
  .output {
    min-width: 0;
  }

  /* Text gets a little more than half and a slightly smaller title, so a title of about 40
     characters fits on two lines at desktop width; in two equal halves it took three. */
  .is-split .inner {
    display: grid;
    gap: 44px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .is-split .inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 48px;
    }
    .is-split h1 {
      font-size: clamp(44px, 5.4vw, 80px);
    }
  }

  .is-stack .head {
    text-align: center;
  }
  .is-stack .eyebrow {
    display: inline-flex;
  }
  .is-stack .lead {
    max-width: 62ch;
    margin-inline: auto;
  }
  /* Input over output, not beside it: side by side, neither the source nor the file names
     get enough width inside --max — the code is cut off and the names wrap to a second row. */
  .is-stack .band {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .is-stack .source {
    min-width: 0;
  }
  .step {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 0;
  }
  .pill {
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--brand);
    /* The page ground, not white: on the light brand of the dark theme white reaches only 3:1. */
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 12px;
    white-space: nowrap;
  }
  .arrow {
    rotate: 90deg;
    color: var(--brand);
    font-size: 20px;
    line-height: 1;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }
  .is-stack .actions {
    justify-content: center;
    margin-top: 34px;
  }

  .is-editorial h1 {
    margin-bottom: 36px;
    font-size: clamp(38px, 6.2vw, 74px);
    line-height: 1.02;
  }
  .is-editorial .row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 44px;
  }
  /* Lead and actions share the row about evenly; the actions keep the install box's width, so
     the badges go below it instead of squeezing the lead into a narrow column. Both start at the
     top, so the lead follows the title directly however tall the actions are. */
  .is-editorial .lead {
    flex: 1 1 380px;
    margin: 0;
  }
  .is-editorial .actions {
    flex: 0 1 470px;
  }

  /* Dark brand ground. Child components follow through the tokens. */
  .invert {
    --heading: #fff;
    --text: rgb(255 255 255 / 0.78);
    --muted: rgb(255 255 255 / 0.68);
    --border: rgb(255 255 255 / 0.2);
    --border-strong: rgb(255 255 255 / 0.32);
    --surface: rgb(255 255 255 / 0.07);
    --bg-deep: rgb(255 255 255 / 0.1);
    --code-bg: rgb(255 255 255 / 0.07);
    --accent: var(--invert-accent);
    --shadow: none;

    background: var(--invert-bg);
    color: var(--text);
  }

  @media (max-width: 640px) {
    .inner {
      padding: 56px 20px 120px;
    }
    .is-stack .actions {
      margin-top: 26px;
    }
    .is-editorial h1 {
      margin-bottom: 26px;
    }
    .is-editorial .row {
      margin-bottom: 32px;
    }
  }
</style>

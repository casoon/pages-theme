---
/**
 * Key figures as one row with hairlines, right under the hero. The lighter sibling of
 * `Facts layout="grid"`: no tiles, just value over label. `label` names the region (default
 * "Key facts"); give it on a page that has more than one.
 */
import config from 'virtual:casoon-pages/config';
import { t } from '../lib/i18n';

interface Props {
  items: { value: string; label: string }[];
  label?: string;
}

const { items, label } = Astro.props;
---

<section class="statband" aria-label={label ?? t(config.lang).keyFacts}>
  <dl class:list={[items.length === 4 && 'is-four']}>
    {
      items.map((item) => (
        <div>
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .statband {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px var(--section-y);
  }
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    margin: 0;
    border-bottom: 1px solid var(--border-strong);
  }
  div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 10px;
    padding: 40px 24px 36px;
  }
  div + div {
    border-left: 1px solid var(--border-strong);
  }
  div:first-child {
    padding-left: 0;
  }
  div:last-child {
    padding-right: 0;
  }
  @media (max-width: 520px) {
    dl:not(.is-four) {
      grid-template-columns: 1fr;
    }
    dl:not(.is-four) div,
    dl:not(.is-four) div:first-child,
    dl:not(.is-four) div:last-child {
      padding: 28px 0;
    }
    dl:not(.is-four) div + div {
      border-left: 0;
      border-top: 1px solid var(--border-strong);
    }
  }
  /* Four items never break 3 + 1: four columns, two by two below 720 px, one below 330 px. */
  dl.is-four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  @media (max-width: 720px) {
    dl.is-four {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .is-four div:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
    .is-four div:nth-child(even) {
      padding-right: 0;
    }
    .is-four div:nth-child(n + 3) {
      border-top: 1px solid var(--border-strong);
    }
  }
  @media (max-width: 330px) {
    dl.is-four {
      grid-template-columns: minmax(0, 1fr);
    }
    .is-four div {
      padding: 24px 0;
      border-left: 0;
    }
    .is-four div + div {
      border-top: 1px solid var(--border-strong);
    }
  }
  dt {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.45;
  }
  dd {
    margin: 0;
    color: var(--heading);
    font-size: clamp(40px, 5vw, 56px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }
</style>

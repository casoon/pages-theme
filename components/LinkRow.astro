---
/**
 * A row of text links with an arrow, for the way on from a section ("Read the guide →"). The
 * quiet alternative to a row of buttons: the page keeps one real button. `Split` and `Section`
 * set their `links` with it.
 */
interface Props {
  links: { label: string; href: string }[];
}

const { links } = Astro.props;
---

{
  links.length > 0 && (
    <div class="links">
      {links.map((link) => (
        <a href={link.href}>{link.label} →</a>
      ))}
    </div>
  )
}

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 26px;
  }
  .links a {
    color: var(--heading);
    font-size: 14.5px;
    font-weight: 600;
  }
  .links a:hover {
    color: var(--accent);
  }
</style>

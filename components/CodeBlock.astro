---
/** Highlighted at build time (Shiki, theme-aware via CSS variables). */
import { Code } from 'astro:components';
import config from 'virtual:casoon-pages/config';
import { t } from '../lib/i18n';

interface Props {
  code: string;
  lang?: string;
  /** File name shown left in the bar. */
  title?: string;
  /** Language label shown right in the bar. */
  label?: string;
  copy?: boolean;
  /** Wrap long lines instead of scrolling sideways (a long command stays fully visible). */
  wrap?: boolean;
  /**
   * Numbered dots at the end of a line (1-based `line`), `aria-hidden`; they belong to the
   * numbered points of a `Split` beside the block. Without it the block renders as before.
   */
  marks?: { line: number; n: number }[];
}

const { code, lang = 'text', title, label, copy = true, wrap = false, marks } = Astro.props;
const transformers = marks?.length
  ? [
      {
        line(node: { children: unknown[] }, line: number) {
          for (const mark of marks.filter((m) => m.line === line)) {
            node.children.push({
              type: 'element',
              tagName: 'span',
              properties: { class: 'mark', 'aria-hidden': 'true' },
              children: [{ type: 'text', value: String(mark.n) }],
            });
          }
        },
      },
    ]
  : undefined;
const s = t(config.lang);

let hash = 5381;
for (const ch of code) hash = ((hash * 33) ^ ch.charCodeAt(0)) >>> 0;
const id = `code-${hash.toString(36)}`;
---

<figure class:list={['codeblock', wrap && 'wrap']}>
  {
    (title || label || copy) && (
      <figcaption>
        <span class="title">{title}</span>
        <span class="right">
          {label}
          {copy && (
            <button class="copy" type="button" data-copy={id} data-copied={s.copied} hidden>
              {s.copy}
            </button>
          )}
        </span>
      </figcaption>
    )
  }
  <div id={id}><Code code={code} lang={lang as never} theme="css-variables" transformers={transformers as never} /></div>
</figure>

<style>
  .codeblock {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--code-bg);
  }
  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 42px;
    padding: 8px 16px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  /* A long file name breaks instead of pushing label and copy button out of the bar. */
  .title {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .right {
    display: flex;
    flex: none;
    align-items: center;
    gap: 12px;
  }
  .copy {
    padding: 2px 9px;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: none;
    color: var(--muted);
    font-size: 12px;
    cursor: pointer;
  }
  .copy:hover {
    border-color: var(--border-strong);
    color: var(--heading);
  }
  .copy[hidden] {
    display: none;
  }
  /* A line that scrolls shows a scrollbar, also where the system hides overlay scrollbars. */
  .codeblock :global(pre) {
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent;
  }
  .wrap :global(pre) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .codeblock :global(.mark) {
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    margin-left: 14px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    user-select: none;
  }
</style>

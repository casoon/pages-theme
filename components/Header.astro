---
import config from 'virtual:casoon-pages/config';
import { t } from '../lib/i18n';
import { url } from '../lib/url';

const s = t(config.lang);
const path = Astro.url.pathname;
const websiteHost = config.website && new URL(config.website).host.replace(/^www\./, '');
const nav = [
  { label: s.docs, href: url('docs/') },
  ...(config.demo ? [{ label: config.demo, href: url('demo/') }] : []),
  ...(config.hasShowcase ? [{ label: s.showcase, href: url('showcase/') }] : []),
  ...(config.changelog ? [{ label: s.changelog, href: url('changelog/') }] : []),
];
const wide = Boolean(websiteHost || nav.length >= 4);
const compact = !wide && nav.length <= 2;
---

<header
  class="header"
  data-wide={wide ? '' : undefined}
  data-compact={compact ? '' : undefined}
>
  <div class="inner">
    <a class="home" href={url()}>
      <span class="name">{config.name}</span>
      {config.version && <span class="version">v{config.version}</span>}
    </a>
    <div class="links">
      {
        websiteHost && (
          <a class="website" href={config.website}>
            {websiteHost}
          </a>
        )
      }
      <nav aria-label={s.mainNav}>
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <span class="sep" aria-hidden="true"></span>
        {
          config.repo && (
            <a class="cta" href={`https://github.com/${config.repo}`}>
              GitHub
              <span class="arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="15" height="15">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </a>
          )
        }
      </nav>
    </div>
    <button class="theme" type="button" data-theme-toggle aria-label={s.darkTheme} aria-pressed="false" hidden>
      <!-- Shows the theme a click switches to: moon while light, sun while dark. -->
      <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
      </svg>
    </button>
  </div>
</header>

<style>
  /* Floating white pill over the page, as wide as the hero. */
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 14px 24px 0;
    pointer-events: none;
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 20px;
    max-width: 1240px;
    height: var(--header-h);
    margin: 0 auto;
    padding: 0 8px 0 24px;
    border: 1px solid var(--border);
    border-radius: 40px;
    background: var(--surface);
    box-shadow: 0 16px 56px rgb(18 20 15 / 0.1);
    pointer-events: auto;
  }
  .home {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--heading);
  }
  .home:hover {
    color: var(--heading);
  }
  .name {
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .version {
    padding: 1px 7px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .website {
    padding: 3px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--text);
    font-size: 13.5px;
    white-space: nowrap;
  }
  .website:hover {
    border-color: var(--accent);
    color: var(--heading);
  }
  .links {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 20px;
    min-width: 0;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: auto;
  }
  ul {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: grid;
    place-items: center;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    color: var(--heading);
    font-size: 14.5px;
    font-weight: 500;
    letter-spacing: -0.012em;
    white-space: nowrap;
    transition: background-color 0.2s;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    background: color-mix(in srgb, var(--heading) 6%, transparent);
    color: var(--heading);
  }
  /* Pill with the arrow in its own white circle on the right. */
  nav a.cta {
    display: flex;
    gap: 12px;
    min-height: 46px;
    padding: 0 4px 0 18px;
    background: linear-gradient(180deg, var(--accent-top) 0%, var(--accent-fill) 25%, var(--accent-fill) 100%);
    color: #fff;
    font-weight: 600;
  }
  nav a.cta:hover {
    background: var(--accent);
    color: #fff;
  }
  .arrow {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    background: #fff;
    color: var(--accent-fill);
    transition: transform 0.3s;
  }
  nav a.cta:hover .arrow {
    transform: translateX(2px);
  }
  .arrow svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sep {
    width: 1px;
    height: 20px;
    margin: 0 8px;
    background: var(--border);
  }
  .theme {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    /* Close to the GitHub link, as if it were the last nav entry: 20px gap - 14px. */
    margin-left: -14px;
    border: 0;
    border-radius: 999px;
    background: var(--bg);
    color: var(--heading);
    cursor: pointer;
  }
  .theme:hover {
    border-color: var(--border-strong);
    color: var(--heading);
  }
  .theme[hidden] {
    display: none;
  }
  .theme svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  :global([data-theme='light']) .icon-sun,
  :global([data-theme='dark']) .icon-moon {
    display: none;
  }
  /* Narrow screens: compact headers (up to 2 nav links, no website pill) stay on one single
     row down to 480 px with tighter spacing instead of wrapping early into an almost empty
     second row. Wider headers wrap cleanly at 640 px (or 860 px with 4+ links / website pill),
     dropping the website pill (repeated in the footer) and keeping the links on one scrollable
     row without clipping or wrapped labels. */
  @media (max-width: 640px) {
    .header {
      padding: 8px 12px 0;
    }
    [data-compact] .inner {
      gap: 10px;
      padding: 0 8px 0 16px;
    }
    [data-compact] .links {
      gap: 8px;
    }
    [data-compact] .sep {
      margin: 0 4px;
    }
    [data-compact] nav a {
      min-height: 36px;
      padding: 0 10px;
      font-size: 14px;
    }
    [data-compact] nav a.cta {
      gap: 8px;
      min-height: 36px;
      padding: 0 3px 0 12px;
    }
    [data-compact] .arrow {
      width: 30px;
      height: 30px;
    }
    [data-compact] .theme {
      margin-left: -4px;
    }
    :global(:root:has(.header:not([data-compact]))) {
      --header-h: 96px;
    }
    .header:not([data-compact]) .inner {
      flex-wrap: wrap;
      align-content: center;
      gap: 6px 8px;
      height: auto;
      min-height: var(--header-h);
      padding: 10px 16px;
      border-radius: 24px;
    }
    .header:not([data-compact]) .links {
      flex: 0 0 calc(100% + 32px);
      order: 3;
      gap: 8px;
      margin: 0 -16px;
      /* Room for the focus outline, which the scroll container would clip. */
      padding: 3px 16px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .header:not([data-compact]) .website {
      display: none;
    }
    .header:not([data-compact]) .theme {
      margin-left: auto;
    }
    .header:not([data-compact]) nav {
      margin-left: 0;
    }
    .header:not([data-compact]) .sep {
      display: none;
    }
    .header:not([data-compact]) nav a {
      min-height: 36px;
      padding: 0 10px;
    }
    .header:not([data-compact]) nav a.cta {
      gap: 8px;
      min-height: 36px;
      padding: 0 3px 0 12px;
    }
    .header:not([data-compact]) .arrow {
      width: 30px;
      height: 30px;
    }
  }
  @media (max-width: 480px) {
    :global(:root) {
      --header-h: 96px;
    }
    .header {
      padding: 8px 8px 0;
    }
    [data-compact] .inner {
      flex-wrap: wrap;
      align-content: center;
      gap: 6px 8px;
      height: auto;
      min-height: var(--header-h);
      padding: 10px 16px;
      border-radius: 24px;
    }
    [data-compact] .links {
      flex: 0 0 calc(100% + 32px);
      order: 3;
      margin: 0 -16px;
      padding: 3px 16px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    [data-compact] .theme {
      margin-left: auto;
    }
    [data-compact] nav {
      margin-left: 0;
    }
    [data-compact] .sep {
      display: none;
    }
  }
  @media (max-width: 860px) {
    :global(:root:has(.header[data-wide])) {
      --header-h: 96px;
    }
    [data-wide] .inner {
      flex-wrap: wrap;
      align-content: center;
      gap: 6px 8px;
      height: auto;
      min-height: var(--header-h);
      padding: 10px 16px;
      border-radius: 24px;
    }
    [data-wide] .links {
      flex: 0 0 calc(100% + 32px);
      order: 3;
      gap: 8px;
      margin: 0 -16px;
      /* Room for the focus outline, which the scroll container would clip. */
      padding: 3px 16px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    [data-wide] .website {
      display: none;
    }
    [data-wide] .theme {
      margin-left: auto;
    }
    [data-wide] nav {
      margin-left: 0;
    }
    [data-wide] .sep {
      display: none;
    }
    [data-wide] nav a {
      min-height: 36px;
      padding: 0 10px;
    }
    [data-wide] nav a.cta {
      gap: 8px;
      min-height: 36px;
      padding: 0 3px 0 12px;
    }
    [data-wide] .arrow {
      width: 30px;
      height: 30px;
    }
  }
</style>

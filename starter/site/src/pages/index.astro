---
import { readFile } from 'node:fs/promises';
import config from 'virtual:casoon-pages/config';
import { useCases } from 'virtual:casoon-pages/use-cases';
import { escapeAnsi } from '@casoon/pages-theme/ansi';
import {
  Badge,
  Badges,
  Button,
  CallToAction,
  CodeBlock,
  Hero,
  Install,
  LinkList,
  ReleaseHighlights,
  Section,
  Showcase,
  StatBand,
  Terminal,
  Tour,
  UseCases,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { parseChangelog } from '@casoon/pages-theme/lib/changelog';
import { url } from '@casoon/pages-theme/url';
import check from '../../../examples/check.ansi?raw';
import report from '../../../examples/report.ansi?raw';

// Skip "Unreleased": it has no version to show as "New in v…" yet.
const latestRelease = config.changelog
  ? parseChangelog(await readFile(config.changelog, 'utf8')).find(
      (r) => r.version.toLowerCase() !== 'unreleased'
    )
  : undefined;

const mainRs = `use runemark::{Renderer, Options};
use std::fs;

let ansi = fs::read_to_string("report.ansi")?;
let html = Renderer::new(Options {
    theme: "auto".into(),
    wrap:  true,
    ..Default::default()
})
.render(&ansi)?;

fs::write("out.html", html)?;`;
---

<Base>
  <Hero
    title="Terminal output that survives the browser."
    lead="runemark renders ANSI streams — status, reports, diffs, errors — as accessible, script-free HTML. Same renderer in Rust and Node."
  >
    <Install
      commands={[
        { label: 'cargo', command: 'cargo add runemark' },
        { label: 'npm', command: 'npm i @casoon/runemark' },
        { label: 'brew', command: 'brew install casoon/tap/runemark' },
      ]}
    />
    <div class="actions">
      <Button href={url('docs/getting-started/quickstart/')}>Read the quickstart</Button>
      <Button href="#tour" variant="quiet">Take the tour ↓</Button>
    </div>
    <Badges>
      <Badge>MIT</Badge>
      <Badge>crates.io 0.4.2</Badge>
      <Badge>npm 0.4.2</Badge>
      <Badge>0 runtime deps</Badge>
    </Badges>
    <Terminal slot="output" title="runemark check ./report" dots ansi={check} />
    <a slot="caption" href={url('showcase/')}>See more output in the examples →</a>
  </Hero>

  <StatBand
    label="runemark in numbers"
    items={[
      { value: '0 kB', label: 'client JavaScript on rendered pages' },
      { value: '142', label: 'golden fixtures, diffed on every build' },
      { value: '4.5:1', label: 'minimum contrast, checked per colour pair' },
      { value: '2', label: 'bindings, one renderer: Rust and Node' },
    ]}
  />

  <Tour
    id="tour"
    title="Captured once, readable everywhere."
    lead="runemark sits between the command that prints colours and the page that shows them. **Nothing runs in the reader's browser.**"
    steps={[
      { title: 'Record the output', body: 'Pipe any command into a file, colours and cursor moves included.' },
      { title: 'Turn it into HTML', body: 'One pass resolves every escape sequence into a flat fragment.' },
      { title: 'Drop it in a page', body: 'Static markup plus one stylesheet, themed by CSS custom properties.' },
    ]}
    link={{ label: 'Rendering pipeline in the docs', href: url('docs/reference/api/') }}
  >
    <div slot="step-1">
      <CodeBlock code={escapeAnsi(report)} title="report.ansi · raw" copy={false} wrap />
      <p class="stage-note">What the command wrote: text with escape sequences, unreadable outside a terminal.</p>
    </div>
    <div slot="step-2">
      <CodeBlock code={mainRs} lang="rust" title="src/main.rs" label="Rust" />
      <p class="stage-note">The same renderer sits behind <code>runemark render</code> on the command line.</p>
    </div>
    <div slot="step-3">
      <Terminal title="out.html" ansi={report} />
      <p class="stage-note">What the reader gets: text and spans, no script, no image.</p>
    </div>
  </Tour>

  <UseCases
    title="What it gets used for"
    link={{ label: 'All use cases', href: url('use-cases/') }}
    items={useCases.map((item) => ({
      title: item.title,
      body: item.body,
      tags: item.tags,
      href: url(`use-cases/#${item.slug}`),
    }))}
  />

  <Showcase
    eyebrow="Examples"
    title="A page that is only output."
    lead="Every example on this site is produced by the package itself during the build."
    link={{ label: 'See all examples', href: url('showcase/') }}
  >
    <Terminal ansi={report} />
  </Showcase>

  <Section
    eyebrow="Documentation"
    title="The surface is deliberately small."
    lead="One renderer, one options struct, two helpers. The docs are versioned with the code."
    links={[{ label: 'Open the docs', href: url('docs/') }]}
  >
    <LinkList
      items={[
        { title: 'Quickstart', body: 'Render a captured ANSI stream to an HTML fragment and put it on a page.', href: url('docs/getting-started/quickstart/') },
        { title: 'Installation', body: 'A Rust crate and a prebuilt Node binding, both wrapping the same renderer.', href: url('docs/getting-started/installation/') },
        { title: 'API reference', body: 'Renderer, Options and the two helpers, with every default.', href: url('docs/reference/api/') },
      ]}
    />
  </Section>

  {latestRelease && <ReleaseHighlights release={latestRelease} size="sub" />}

  <CallToAction
    title="Render your first report in a minute."
    href={url('docs/getting-started/quickstart/')}
    label="Read the quickstart"
  />
</Base>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }
  .stage-note {
    margin: 16px 0 0;
    font-size: 14.5px;
  }
  .stage-note code {
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--code-bg);
    font-size: 0.9em;
  }
</style>
